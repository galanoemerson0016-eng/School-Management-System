{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.exe"
    ],
    "headers": [
      {
        "source": "**/*.exe",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/x-msdownload"
          }
        ]
      },
      {
        "source": "**/*.yml",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
