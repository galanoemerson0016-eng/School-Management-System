rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userRoles() {
      return userDoc().roles is list
        ? userDoc().roles
        : (userDoc().role != null ? [userDoc().role] : []);
    }

    function hasRole(role) {
      return signedIn() && (role in userRoles());
    }

    function canManageEnrollmentData() {
      return hasRole('admin') ||
        hasRole('principal') ||
        hasRole('registrar') ||
        hasRole('staff') ||
        hasRole('adviser');
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || hasRole('admin'));
      allow write: if hasRole('admin');
    }

    match /settings/schoolProfile {
      allow read: if signedIn();
      allow write: if hasRole('admin') || hasRole('principal');
    }

    match /students/{studentId} {
      allow read: if signedIn();
      allow write: if canManageEnrollmentData();
    }

    match /enrollments/{enrollmentId} {
      allow read: if signedIn();
      allow write: if canManageEnrollmentData();
    }

    // Commercial License Rules (G7 Special)
    match /artifacts/g7-special/public/data/licenses/{licenseId} {
      // Allow the desktop app to verify a specific key if it knows the ID
      // But prevent listing all keys (browsing) unless admin
      allow get: if true;
      allow list: if hasRole('admin');
      
      // Allow the desktop app to bind the device ID to the key (activation)
      // Strict check: only if it's currently empty
      allow update: if (resource.data.machine_id == "" && request.resource.data.machine_id != "" && request.resource.data.status == "activated") || 
                     hasRole('admin');
      
      // Only admins can create or delete keys
      allow create, delete: if hasRole('admin');
    }

    match /{document=**} {
      // Emergency Fallback: If you are the first user and haven't set up the 'users' collection yet,
      // this allows you to manage the portal. 
      // RECOMMENDATION: Remove the '|| signedIn()' part once you've added your UID to the 'users' collection with role 'admin'
      allow read, write: if hasRole('admin') || signedIn();
    }
  }
}
