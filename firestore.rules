rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function signedIn() {
      return request.auth != null;
    }

    // Commercial License Rules (G7 Special)
    match /artifacts/g7-special/public/data/licenses/{licenseId} {
      // Allow the desktop app to verify a specific key if it knows the ID
      allow get: if true;
      
      // Prevent listing all keys (browsing) unless signed into the Admin Portal
      allow list: if signedIn();
      
      // Allow the desktop app to bind the device ID to the key (activation)
      // Strict check: only if it's currently empty
      allow update: if (resource.data.machine_id == "" && request.resource.data.machine_id != "" && request.resource.data.status == "activated") || 
                     signedIn();
      
      // Only admins can create or delete keys
      allow create, delete: if signedIn();
    }

    // Purchase Requests
    match /artifacts/g7-special/admin/data/purchase_requests/{requestId} {
      // Anyone can submit a purchase request
      allow create: if true;
      
      // Users need to check their request status (query by email and proof_id)
      allow list: if true; 
      
      // Only admins can read all, update, and delete
      allow get, update, delete: if signedIn();
    }

    // School-Wide Interconnected Announcements
    match /shared_announcements/{announcementId} {
      // Anyone can see announcements
      allow read: if true;
      
      // Anyone signed in can create announcements
      allow create: if signedIn();
      
      // ONLY the author of the post can delete or update it from the cloud
      allow delete, update: if signedIn() && (resource.data.author_id == request.auth.uid);
    }
  }
}
