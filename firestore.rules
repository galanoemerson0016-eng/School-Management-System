rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Any authenticated session, INCLUDING the anonymous identity that every
    // FormEase Pro desktop install signs in with (see auth-store.ts) so the
    // shared_announcements feature satisfies these rules.
    function signedIn() {
      return request.auth != null;
    }

    // Provision this claim with the Admin SDK before deploying these rules.
    // A password/Google sign-in by itself never grants administrative access.
    function isAdmin() {
      return request.auth != null && request.auth.token.get('admin', false) == true;
    }

    // Commercial License Rules (G7 Special)
    match /artifacts/g7-special/public/data/licenses/{licenseId} {
      // The desktop app verifies a specific key by ID. Serials are
      // high-entropy (36^16 keyspace) so this is not practically enumerable.
      allow get: if true;

      // Browsing/creating/deleting the license catalog is admin-only.
      allow list, create, delete: if isAdmin();

      // First-activation "claim" from the desktop app (unauthenticated):
      // only while the license is unclaimed (machine_id == ""), and only
      // the activation-related fields may change. Every other field
      // (serial, platform, duration_months, batch_id, created_at) must be
      // unchanged, and the new expires_at must be a sane near-future date —
      // this prevents a claim request from also rewriting plan/expiry/
      // platform on someone else's license.
      allow update: if isAdmin() || (
        resource.data.machine_id == ""
        && request.resource.data.machine_id is string
        && request.resource.data.machine_id != ""
        && request.resource.data.status == 'activated'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['machine_id', 'status', 'activated_at', 'expires_at', 'registered_to'])
        && request.resource.data.get('serial', null) == resource.data.get('serial', null)
        && request.resource.data.get('platform', null) == resource.data.get('platform', null)
        && request.resource.data.get('duration_months', null) == resource.data.get('duration_months', null)
        && request.resource.data.get('batch_id', null) == resource.data.get('batch_id', null)
        && request.resource.data.get('created_at', null) == resource.data.get('created_at', null)
        && request.resource.data.expires_at is timestamp
        && request.resource.data.expires_at > request.time
        && request.resource.data.expires_at <= request.time + duration.value(400, 'd')
      );
    }

    // Trial Devices
    // NOTE: trialId is SHA-256(machineId) — the raw machine ID is NOT stored
    // in the document or the path. This prevents enumerating which machines
    // have claimed trials by guessing predictable machine ID formats.
    match /artifacts/g7-special/public/data/trials/{trialId} {
      // Anyone can check if their device has already claimed a trial (by hash).
      allow get: if true;

      // A device may register exactly one trial for itself. The document id
      // must match the machine_id_hash field and only these fields are allowed
      // — this is a `create` only, so a device cannot later edit/delete its
      // own record to reset the "already claimed" flag.
      allow create: if request.resource.data.machine_id_hash == trialId
        && request.resource.data.machine_id_hash is string
        && request.resource.data.started_at is timestamp
        && request.resource.data.platform in ['windows', 'mac']
        && request.resource.data.keys().hasOnly(['machine_id_hash', 'started_at', 'platform']);

      // Browsing/removing trial records (e.g. to manually reset a device's
      // trial) is admin-only.
      allow list, delete: if isAdmin();
    }

    // Purchase Requests
    match /artifacts/g7-special/admin/data/purchase_requests/{requestId} {
      // Public submissions may request review, but cannot self-approve or
      // assign licenses. Trusted payment functions bypass client rules.
      allow create: if request.resource.data.keys().hasOnly([
          'name', 'email', 'payment_method', 'duration', 'proof_id', 'platform',
          'proof_image', 'status', 'created_at', 'license_key'
        ])
        && request.resource.data.status == 'pending'
        && request.resource.data.license_key == null
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.platform in ['windows', 'mac'];

      // Every record holds customer PII (name, email, payment proof image)
      // and, once approved, a live unredeemed license_key. Reading,
      // listing, updating or deleting these is admin-only — order status
      // is checked via the checkOrderStatus Cloud Function instead, which
      // returns only {status, license_key, decline_reason}.
      allow list, get, update, delete: if isAdmin();
    }

    // Downloads and Installer Links
    match /artifacts/g7-special/public/data/downloads_info/{infoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Global Announcements (Read-Only for clients, Write/Edit for Admin/Developer)
    match /shared_announcements/{announcementId} {
      allow read: if true;
      allow write, create, update, delete: if isAdmin();
    }

    // Global Admin / System Broadcasts (Read-Only for clients, Write/Edit for Admin/Developer)
    match /system_broadcasts/{broadcastId} {
      allow read: if true;
      allow write, create, update, delete: if isAdmin();
    }

    // Diagnostic & Client Bug Reports (Clients can submit, Admin can list, read, update, delete)
    match /diagnostic_reports/{reportId} {
      allow create: if true;
      allow read, list, update, delete: if isAdmin();
    }
  }
}
