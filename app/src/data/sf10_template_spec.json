  "validationRules": {
    "learner.lrn": {
      "type": "string",
      "pattern": "^[0-9]{12}$|^[0-9]{0,12}$",
      "message": "LRN should be a 12-digit number or blank."
    },
    "learner.birthdate": {
      "type": "string",
      "pattern": "^(0[1-9]|1[0-2])\\/(0[1-9]|[12][0-9]|3[01])\\/([0-9]{4})$|^$",
      "message": "Birthdate must be in mm/dd/yyyy format or blank."
    },
    "schoolYear": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{4}$|^$",
      "message": "School Year must be in YYYY-YYYY format or blank."
    },
    "gradeValue": {
      "type": "string",
      "pattern": "^(100|[0-9]{1,2}(\\.[0-9]{1,2})?)$|^$",
      "message": "Grade must be numeric or blank."
    },
    "learner.sex": {
      "type": "string",
      "maxLength": 10
    }
  },
  "printRules": {
    "fixedPages": true,
