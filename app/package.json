{
  "name": "form-ease-pro",
  "private": true,
  "version": "1.0.22",
  "description": "Professional School Management System",
  "author": "Emerson M. Galano",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3001 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "cross-env CSC_LINK=null WIN_CSC_LINK=null npm run build && electron-builder",
    "electron:build:mac": "cross-env CSC_LINK=null WIN_CSC_LINK=null npm run build && electron-builder --mac",
    "electron:build:win": "cross-env CSC_LINK=null WIN_CSC_LINK=null npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.formease.pro",
    "productName": "FormEase Pro",
    "copyright": "Copyright © 2026 Department of Education",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://formease-app-a3e68.web.app/updates"
      }
    ],
    "win": {
      "icon": "public/app-logo.png",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "NSHighResolutionCapable": true,
        "NSRequiresAquaSystemAppearance": false
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "FormEase Pro"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ]
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.3.2",
    "@tanstack/react-table": "^8.21.3",
    "buffer": "^6.0.3",
    "dom-to-image-more": "^3.7.2",
    "electron-updater": "^6.8.3",
    "express": "^4.21.2",
    "firebase": "^12.12.1",
    "framer-motion": "^12.33.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.1.0",
    "lucide-react": "^0.563.0",
    "node-machine-id": "^1.1.12",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.2.2",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "javascript-obfuscator": "^5.4.2",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-javascript-obfuscator": "^3.1.0",
    "wait-on": "^9.0.5"
  }
}
