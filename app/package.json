{
  "name": "form-ease-pro",
  "private": true,
  "version": "2.9.0",
  "description": "Professional School Management System",
  "author": "Emerson M. Galano",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3001 && cross-env NODE_ENV=development electron .\"",
    "obfuscate:electron": "node scripts/obfuscate-electron.cjs",
    "electron:build": "cross-env CSC_LINK=null WIN_CSC_LINK=null npm run build && npm run obfuscate:electron && electron-builder",
    "electron:build:mac": "cross-env CSC_LINK=null WIN_CSC_LINK=null npm run build && npm run obfuscate:electron && electron-builder --mac",
    "electron:build:win": "cross-env CSC_LINK=null WIN_CSC_LINK=null npm run build && npm run obfuscate:electron && electron-builder --win"
  },
  "build": {
    "appId": "com.formease.pro",
    "productName": "FormEase Pro",
    "copyright": "Copyright © 2026 Department of Education",
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://formease-licensing.web.app/updates"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "forceCodeSigning": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    },
    "mac": {
      "category": "public.app-category.education",
      "forceCodeSigning": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "NSHighResolutionCapable": true,
        "NSRequiresAquaSystemAppearance": false
      }
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FormEase Pro"
    },
    "files": [
      "dist/**/*",
      {
        "from": "dist-electron",
        "to": "electron",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.3.2",
    "@tanstack/react-table": "^8.21.3",
    "buffer": "^6.0.3",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.3",
    "express": "^4.21.2",
    "firebase": "^12.12.1",
    "framer-motion": "^12.33.0",
    "html2canvas-pro": "^2.0.4",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.1.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.563.0",
    "node-machine-id": "^1.1.12",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.2.2",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase-tools": "^15.23.0",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "javascript-obfuscator": "^5.4.3",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-javascript-obfuscator": "^3.1.0",
    "vitest": "^4.1.8",
    "wait-on": "^9.0.5"
  }
}
